@page "/"
@using MetalStorming20.Core
@using MetalStorming20.Web.Controllers
@using MetalStorming20.Web.Presenters
@inject Upgrades2Controller Controller

<PageTitle>Upgrades 2.0 Planner</PageTitle>

<h1>Upgrades 2.0 Planner</h1>
<p class="lead">Plan aircraft levels, every system track, branch ownership, and required resources.</p>
<div class="alert alert-info py-2" role="note">
    Green owned nodes are your current state. Blue desired nodes are your target state. Costs are calculated for the gap between owned and desired. If you jump to a branch node such as 7A without an owned path before it, the planner marks the required prior path green automatically.
</div>
<div class="d-flex justify-content-end mb-3">
    <button type="button" class="btn btn-outline-secondary" @onclick="() => Controller.StartNewBuildAsync()">Start New Build</button>
</div>

@if (Controller.ViewModel.Result is not null)
{
    <section class="costs-summary-panel border rounded p-3 mb-3" data-testid="costs-summary">
        <h2 class="h5">Costs Summary</h2>
        <div class="cost-summary-list" aria-label="Costs summary">
            @if (Controller.ViewModel.Result.TotalsRequired.Count == 0)
            {
                <div class="text-muted">No costs selected</div>
            }
            else
            {
                @foreach (var total in Controller.ViewModel.Result.TotalsRequired)
                {
                    <div class="cost-summary-row">
                        <span class="cost-summary-amount">@SummaryAmount(total)</span>
                        <span class="@CurrencyIconCss(total.CurrencyCode)" aria-hidden="true"></span>
                        <span>@SummaryDisplayName(total.CurrencyCode)</span>
                    </div>
                }
            }
        </div>

        <details class="cost-details mt-3">
            <summary>Expand for Detail</summary>

            @if (Controller.ViewModel.Result.HasWarnings)
            {
                <div class="alert alert-warning mt-3">
                    <h3 class="h6">Warnings</h3>
                    <ul class="mb-0">
                        @foreach (var warning in Controller.ViewModel.Result.Warnings)
                        {
                            <li>@warning</li>
                        }
                    </ul>
                </div>
            }

            <div class="row g-3 mt-1">
                <div class="col-md-6">
                    <div class="border rounded p-3 h-100">
                        <h3 class="h5">Totals Required</h3>
                        @foreach (var total in Controller.ViewModel.Result.TotalsRequired)
                        {
                            <div>@total.DisplayText</div>
                        }
                    </div>
                </div>
                @if (Controller.ViewModel.Result.HasMasteryRebate)
                {
                    <div class="col-md-6">
                        <div class="border rounded p-3 h-100">
                            <h3 class="h5">Mastery Rebate</h3>
                            @foreach (var rebate in Controller.ViewModel.Result.MasteryRebate)
                            {
                                <div>@rebate.DisplayText</div>
                            }
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="border rounded p-3 h-100" data-testid="net-grind-needed">
                            <h3 class="h5">Net Grind Needed</h3>
                            @if (!Controller.ViewModel.Result.HasNetGrindNeeded)
                            {
                                <div>None</div>
                            }
                            else
                            {
                                @foreach (var net in Controller.ViewModel.Result.NetGrindNeeded)
                                {
                                    <div>@net.DisplayText</div>
                                }
                            }
                        </div>
                    </div>
                }
            </div>

            <div class="row g-3 mt-1">
                <div class="col-md-4">
                    <label for="currency-filter" class="form-label">Currency filter</label>
                    <select id="currency-filter" class="form-select" @bind="currencyFilter">
                        @foreach (var filter in Controller.ViewModel.CurrencyFilters)
                        {
                            <option value="@filter.Value">@filter.Label</option>
                        }
                    </select>
                </div>
            </div>

            <section class="mt-3">
                <h3 class="h5">Purchase Steps</h3>
                <h4 class="h6">Aircraft</h4>
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Step</th>
                            <th>Costs</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var step in FilteredSteps)
                        {
                            <tr>
                                <td>@step.Order</td>
                                <td>@step.StepText</td>
                                <td>@step.CostsText</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </section>
        </details>
    </section>
}

<section class="border rounded p-3">
    <h2 class="h5">Aircraft Level</h2>
    <div class="level-grid" role="group" aria-label="Aircraft level nodes">
        @foreach (var level in AircraftLevels)
        {
            var node = Controller.SessionViewModel.AircraftLevels.FirstOrDefault(node => node.Level == level);
            <button type="button" class="@(node?.CssClass ?? "node-toggle")" data-state="@(node?.State ?? "off")" aria-pressed="@((node?.IsPressed ?? false).ToString().ToLowerInvariant())" @onclick="() => Controller.CycleAircraftLevelAsync(level)">@(node?.Label ?? level.ToString())</button>
        }
    </div>
</section>

<section class="border rounded p-3 mt-3">
    <h2 class="h5">Mastery</h2>
    <div class="d-flex flex-wrap gap-2 align-items-center mb-3">
        <button type="button" class="@Controller.SessionViewModel.GoldCssClass" data-state="@Controller.SessionViewModel.GoldState" aria-pressed="@Controller.SessionViewModel.IsGoldPressed.ToString().ToLowerInvariant()" @onclick="() => Controller.CycleGoldMasteryStatusAsync()">Gold</button>
    </div>
    <div>
        <div class="level-grid" role="group" aria-label="Mastery level nodes">
            @foreach (var level in MasteryLevels)
            {
                var node = Controller.SessionViewModel.MasteryLevels.FirstOrDefault(node => node.Level == level);
                <button type="button" class="@(node?.CssClass ?? "node-toggle")" data-state="@(node?.State ?? "off")" aria-pressed="@((node?.IsPressed ?? false).ToString().ToLowerInvariant())" @onclick="() => Controller.CycleMasteryLevelAsync(level)">@(node?.Label ?? level.ToString())</button>
            }
        </div>
    </div>
</section>

<section class="border rounded p-3 mt-3">
    <h2 class="h5">System Tracks</h2>
    <div class="table-responsive system-track-table">
        <table class="table align-middle mb-0">
            <thead>
                <tr>
                    <th>Upgrade type</th>
                    <th>Target nodes</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in Controller.SessionViewModel.SystemPlans)
                {
                    <tr data-testid="@($"system-{row.Slug}")">
                        <th scope="row">@row.DisplayName</th>
                        <td>
                            <div class="node-grid" role="group" aria-label="@($"{row.DisplayName} target nodes")">
                                @foreach (var node in row.TrunkNodes)
                                {
                                    <button type="button" class="@node.CssClass" data-state="@node.State" aria-pressed="@node.IsPressed.ToString().ToLowerInvariant()" @onclick="() => Controller.CycleNodeAsync(row.SystemSlotId, node.Level, node.BranchCode)">@node.Label</button>
                                }
                                @foreach (var stack in row.BranchNodeStacks)
                                {
                                    <div class="branch-stack">
                                        @foreach (var node in stack)
                                        {
                                            <button type="button" class="@node.CssClass" data-state="@node.State" aria-pressed="@node.IsPressed.ToString().ToLowerInvariant()" @onclick="() => Controller.CycleNodeAsync(row.SystemSlotId, node.Level, node.BranchCode)">@node.Label</button>
                                        }
                                    </div>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>

<style>
    .node-grid {
        display: flex;
        align-items: center;
        gap: 0.35rem;
        min-width: 30rem;
    }

    .level-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, 2.65rem);
        gap: 0.35rem;
    }

    .node-toggle {
        width: 2.65rem;
        height: 2.65rem;
        border: 1px solid #6c757d;
        border-radius: 0.25rem;
        background: #fff;
        color: #212529;
        font-weight: 700;
        line-height: 1;
    }

    .gold-toggle {
        width: auto;
        min-width: 4.5rem;
        padding-inline: 0.75rem;
    }

    .node-toggle.desired {
        background: #0d6efd;
        border-color: #0d6efd;
        color: #fff;
    }

    .node-toggle.has {
        background: #198754;
        border-color: #198754;
        color: #fff;
    }

    .branch-stack {
        display: grid;
        grid-template-rows: 2.65rem 2.65rem;
        gap: 0.25rem;
    }

    .cost-summary-list {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem 1rem;
    }

    .cost-summary-row {
        display: inline-grid;
        grid-template-columns: max-content 1.25rem max-content;
        align-items: center;
        gap: 0.35rem;
        min-height: 1.75rem;
        white-space: nowrap;
    }

    .cost-summary-amount {
        font-weight: 700;
    }

    .currency-icon {
        width: 1rem;
        height: 1rem;
        border-radius: 50%;
        display: inline-block;
        border: 1px solid rgba(0, 0, 0, 0.2);
    }

    .currency-icon.gold {
        background: #f4c430;
    }

    .currency-icon.silver {
        background: #c7ced7;
    }

    .currency-icon.aircraft-parts {
        background: #2f80ed;
    }

    .currency-icon.system-parts {
        background: #20a464;
    }

    .currency-icon.advanced-parts {
        background: #b05cd6;
    }

    .cost-details > summary {
        cursor: pointer;
        font-weight: 600;
    }
</style>

@code {
    private string currencyFilter = "";
    private bool localStateLoaded;

    private static readonly int[] AircraftLevels = Enumerable.Range(1, 20).ToArray();
    private static readonly int[] MasteryLevels = Enumerable.Range(1, 24).ToArray();

    private IEnumerable<Upgrades2PlanStepViewModel> FilteredSteps => Controller.ViewModel.Result?.Steps
        .Where(s => string.IsNullOrEmpty(currencyFilter) || s.CurrencyCodes.Any(c => c == currencyFilter))
        ?? [];

    private static string SummaryAmount(Upgrades2CurrencyAmountViewModel amount)
    {
        const string separator = " ";
        var separatorIndex = amount.DisplayText.IndexOf(separator, StringComparison.Ordinal);
        return separatorIndex >= 0
            ? amount.DisplayText[(separatorIndex + separator.Length)..]
            : amount.DisplayText;
    }

    private static string SummaryDisplayName(string currencyCode) =>
        currencyCode switch
        {
            PlannerV2.Currencies.Gold => "Gold",
            PlannerV2.Currencies.Silver => "Silver",
            PlannerV2.Currencies.AircraftParts => "Aircraft Parts",
            PlannerV2.Currencies.AdvancedParts => "Advanced Parts",
            PlannerV2.Currencies.FuselageParts or
            PlannerV2.Currencies.EngineParts or
            PlannerV2.Currencies.AvionicsParts or
            PlannerV2.Currencies.CannonParts or
            PlannerV2.Currencies.MissileParts or
            PlannerV2.Currencies.RocketParts => "System Parts",
            _ => currencyCode.Replace("_", " ", StringComparison.OrdinalIgnoreCase)
        };

    private static string CurrencyIconCss(string currencyCode) =>
        currencyCode switch
        {
            PlannerV2.Currencies.Gold => "currency-icon gold",
            PlannerV2.Currencies.Silver => "currency-icon silver",
            PlannerV2.Currencies.AircraftParts => "currency-icon aircraft-parts",
            PlannerV2.Currencies.AdvancedParts => "currency-icon advanced-parts",
            PlannerV2.Currencies.FuselageParts or
            PlannerV2.Currencies.EngineParts or
            PlannerV2.Currencies.AvionicsParts or
            PlannerV2.Currencies.CannonParts or
            PlannerV2.Currencies.MissileParts or
            PlannerV2.Currencies.RocketParts => "currency-icon system-parts",
            _ => "currency-icon"
        };

    protected override async Task OnInitializedAsync()
    {
        await Controller.InitializeAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (localStateLoaded || Controller.SessionViewModel.SystemPlans.Count == 0)
        {
            return;
        }

        localStateLoaded = true;
        await Controller.LoadSavedStateAsync();
        StateHasChanged();
    }
}
